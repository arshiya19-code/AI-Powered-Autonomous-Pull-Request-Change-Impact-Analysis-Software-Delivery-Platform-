# AI-Powered Autonomous Change Impact Analysis Platform
# Environment Configuration Template
# Copy this file to .env and fill in your values

# ==========================================
# GitHub Configuration
# ==========================================
# GitHub App credentials. Use either an inline PEM or a PEM file path.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# ==========================================
# LLM Configuration
# ==========================================
# LLM Provider: ollama, openai, anthropic, vllm
LLM_PROVIDER=openrouter

# Model name (e.g., qwen2.5-coder, llama3.3, gpt-4, claude-3-opus)
LLM_MODEL=qwen/qwen2.5-coder-7b-instruct

# OpenAI-compatible base URL (Ollama example includes /v1)
LLM_BASE_URL=http://localhost:11434/v1

# API Key (for OpenAI, Anthropic, etc.)
LLM_API_KEY=

# Temperature for generation (0.0 - 1.0)
LLM_TEMPERATURE=0

# Max tokens for response
LLM_MAX_TOKENS=1200

# Optional authorized fallback; leave blank to disable. Credentials never cross providers.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# Additional providers may use LLM_FALLBACK_2_ through LLM_FALLBACK_4_.

# ==========================================
# Database Configuration
# ==========================================
# SQLite for local development, PostgreSQL for production

# ==========================================
# ML Model Configuration
# ==========================================
# Path to save/load CatBoost model
CATBOOST_MODEL_PATH=models/catboost_model.cbm

# Model training parameters
CATBOOST_ITERATIONS=1000
CATBOOST_LEARNING_RATE=0.1
CATBOOST_DEPTH=6
CATBOOST_LOSS_FUNCTION=Logloss
CATBOOST_EVAL_METRIC=AUC

# SHAP configuration
SHAP_SAMPLE_SIZE=1000
SHAP_MAX_DISPLAY=20

# ==========================================
# Analysis Configuration
# ==========================================
# Maximum repository size to analyze (MB)
MAX_REPO_SIZE_MB=500

# File extensions to analyze
ANALYZE_EXTENSIONS=.py

# Directories to exclude from analysis
EXCLUDE_DIRS=__pycache__,.git,venv,env,.venv,.env,node_modules,dist,build,.pytest_cache,.mypy_cache,htmlcov,.coverage

# Maximum file size to parse (KB)
MAX_FILE_SIZE_KB=500

# ==========================================
# Impact Analysis Configuration
# ==========================================
# Impact propagation decay factor (0.0 - 1.0)
IMPACT_DECAY_FACTOR=0.7

# Minimum impact score to consider a component affected
MIN_IMPACT_THRESHOLD=0.1

# Maximum graph traversal depth
MAX_TRAVERSAL_DEPTH=10

# Relationship strength weights
WEIGHT_IMPORT=1.0
WEIGHT_FUNCTION_CALL=0.8
WEIGHT_INHERITANCE=0.9
WEIGHT_MODULE_REFERENCE=0.6

# ==========================================
# Repair Engine Configuration
# ==========================================
# Maximum repair iterations
MAX_REPAIR_ITERATIONS=3

# Timeout for validation pipeline (seconds)
VALIDATION_TIMEOUT=300

# Enable autonomous repair
ENABLE_AUTONOMOUS_REPAIR=true

# ==========================================
# CI/CD Configuration
# ==========================================
# GitHub Actions runner labels
GITHUB_RUNNER_LABELS=ubuntu-latest

# Artifact retention days
ARTIFACT_RETENTION_DAYS=7

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/analysis.log

# ==========================================
# API Server Configuration
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
# Backend intelligence
RISK_MODEL_PATH=models/risk_model/catboost_apachejit.cbm
DEMO_MODE=false
SHAP_ENABLED=true
FEEDBACK_STORE_PATH=backend/feedback.sqlite3
PROMETHEUS_ENABLED=true
PROMETHEUS_BASE_URL=
# Account persistence (PostgreSQL recommended for production)
# DATABASE_URL=postgresql+psycopg://impact:password@localhost:5432/impact
# SQLite is the development fallback; production requires running Alembic first.
DATABASE_URL=sqlite:///./backend/accounts.sqlite3
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Set true behind production HTTPS. Local HTTP development uses false.
COOKIE_SECURE=false
# Optional password recovery; secrets stay on the server.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=accounts@example.com
# SMTP_USER=
# SMTP_PASSWORD=

# CI orchestration: local is the explicit subprocess fallback.
CI_EXECUTOR=local
JENKINS_URL=
JENKINS_JOB=candidate-validation
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_TIMEOUT=1200
# Same absolute shared directory on backend and Jenkins agent.
CI_SHARED_ROOT=
SONAR_HOST_URL=
SONAR_TOKEN=
SNYK_TOKEN=
